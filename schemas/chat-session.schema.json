{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bridge.local/schemas/chat-session.schema.json",
  "title": "Agent Bridge interactive chat session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "createdAt",
    "updatedAt",
    "status",
    "projectRoot",
    "projectKind",
    "maxAutoRounds",
    "retries",
    "timeoutMinutes",
    "noTranscript",
    "messages",
    "workflows"
  ],
  "properties": {
    "version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["active", "paused", "completed"] },
    "projectRoot": { "type": "string", "minLength": 1 },
    "projectKind": { "enum": ["git", "directory"] },
    "maxAutoRounds": { "type": "integer", "minimum": 2, "maximum": 20 },
    "retries": { "type": "integer", "minimum": 0, "maximum": 3 },
    "timeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 180 },
    "noTranscript": { "type": "boolean" },
    "screenReader": { "type": "boolean" },
    "noColor": { "type": "boolean" },
    "codexModel": { "type": "string" },
    "claudeModel": { "type": "string" },
    "codexEffort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
    "claudeEffort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
    "nextFirstAgent": { "enum": ["codex", "claude"] },
    "pendingExchange": { "$ref": "#/$defs/pendingExchange" },
    "messages": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/message" }
    },
    "workflows": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflow" }
    }
  },
  "$defs": {
    "pendingExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstAgent", "secondAgent", "firstMessageSequence"],
      "properties": {
        "firstAgent": { "enum": ["codex", "claude"] },
        "secondAgent": { "enum": ["codex", "claude"] },
        "firstMessageSequence": { "type": "integer", "minimum": 1 }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "createdAt", "role", "text"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "role": { "enum": ["user", "codex", "claude", "system"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000000 },
        "decision": { "enum": ["done", "continue"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "enum": ["codex", "claude"] } },
            "required": ["role"]
          },
          "then": { "required": ["decision"] },
          "else": { "not": { "required": ["decision"] } }
        }
      ]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "startedAt", "completedAt", "mode", "exitCode"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "mode": { "enum": ["review", "fixed", "collaborative"] },
        "firstAgent": { "enum": ["codex", "claude"] },
        "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "review" } },
            "required": ["mode"]
          },
          "then": { "not": { "required": ["firstAgent"] } },
          "else": { "required": ["firstAgent"] }
        }
      ]
    }
  }
}
