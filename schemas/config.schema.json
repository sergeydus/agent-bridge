{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bridge.local/schemas/config.schema.json",
  "title": "Agent Bridge user configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "recentProjects"],
  "properties": {
    "version": { "const": 1 },
    "recentProjects": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
