{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bridge.local/schemas/config.schema.json",
  "title": "Agent Bridge user configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "recentProjects"],
  "properties": {
    "version": { "const": 3 },
    "recentProjects": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenReader", "ui"],
      "properties": {
        "screenReader": { "type": "boolean" },
        "color": {
          "type": "boolean",
          "description": "Explicit color choice; absent means defer to automatic detection"
        },
        "ui": { "enum": ["plain", "enhanced", "auto"] }
      }
    }
  }
}
