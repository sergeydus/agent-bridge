{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bridge.local/schemas/agent-response.schema.json",
  "title": "Structured agent turn response",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "text"],
  "properties": {
    "decision": { "enum": ["done", "continue"] },
    "text": { "type": "string", "minLength": 1 }
  }
}
