{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bridge.local/schemas/project-config.schema.json",
  "title": "Agent Bridge project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "verification", "protectedPaths"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "version": { "const": 1 },
    "verification": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/command" }
    },
    "protectedPaths": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$))[^\\u0000]+$"
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\\\s]+$"
        },
        "args": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string" }
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        }
      }
    }
  }
}
