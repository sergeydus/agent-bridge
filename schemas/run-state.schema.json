{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bridge.local/schemas/run-state.schema.json",
  "title": "Agent Bridge saved run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "createdAt",
    "updatedAt",
    "status",
    "task",
    "originalCwd",
    "agentCwd",
    "projectKind",
    "outputDirectory",
    "workflow",
    "judge",
    "retries",
    "timeoutMinutes",
    "untilAgreement",
    "requireAgreement",
    "noTranscript",
    "verification",
    "protectedPaths",
    "protectedPathFingerprints",
    "completedCycles",
    "codexPrevious",
    "claudePrevious",
    "handoff",
    "converged",
    "rounds"
  ],
  "properties": {
    "version": { "const": 2 },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "status": {
      "enum": [
        "created",
        "planning",
        "implementing",
        "reviewing",
        "synthesizing",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "task": { "type": "string" },
    "originalCwd": { "type": "string" },
    "agentCwd": { "type": "string" },
    "projectKind": { "enum": ["git", "directory"] },
    "outputDirectory": { "type": "string" },
    "recoveryPatchPath": { "type": "string" },
    "workspace": { "type": "string" },
    "baseRevision": { "type": "string" },
    "currentRevision": { "type": "string" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "maxRounds"],
      "properties": {
        "kind": { "enum": ["review", "fixed", "collaborative"] },
        "firstAgent": { "enum": ["codex", "claude"] },
        "maxRounds": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "judge": { "enum": ["codex", "claude"] },
    "codexModel": { "type": "string" },
    "claudeModel": { "type": "string" },
    "codexEffort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
    "claudeEffort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
    "retries": { "type": "integer", "minimum": 0, "maximum": 3 },
    "timeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 180 },
    "untilAgreement": { "type": "boolean" },
    "requireAgreement": { "type": "boolean" },
    "noTranscript": { "type": "boolean" },
    "verification": {
      "type": "array",
      "items": { "$ref": "project-config.schema.json#/$defs/command" }
    },
    "protectedPaths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "protectedPathFingerprints": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "completedCycles": { "type": "integer", "minimum": 0 },
    "codexPrevious": { "type": "string" },
    "claudePrevious": { "type": "string" },
    "handoff": { "type": "string" },
    "converged": { "type": "boolean" },
    "pendingReview": { "$ref": "#/$defs/pendingReview" },
    "rounds": {
      "type": "array",
      "items": { "$ref": "#/$defs/round" }
    },
    "error": { "type": "string" }
  },
  "$defs": {
    "pendingReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "implementer",
        "implementerResponse",
        "verification",
        "verificationComplete"
      ],
      "properties": {
        "round": { "type": "integer", "minimum": 1 },
        "implementer": { "enum": ["codex", "claude"] },
        "implementerResponse": { "type": "string" },
        "implementerDecision": { "enum": ["done", "continue"] },
        "revision": { "type": "string" },
        "verification": { "type": "string" },
        "verificationComplete": { "type": "boolean" }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "round", "codex", "claude"],
      "properties": {
        "phase": { "type": "string" },
        "round": { "type": "integer", "minimum": 1 },
        "codex": { "type": "string" },
        "claude": { "type": "string" },
        "codexDecision": { "enum": ["done", "continue"] },
        "claudeDecision": { "enum": ["done", "continue"] },
        "revision": { "type": "string" }
      }
    }
  }
}
